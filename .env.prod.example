# ── База данных ────────────────────────────────────────────────────────────────
# Пароль придумай сам, используй в docker-compose.prod.yml
DB_NAME=payroll
DB_USER=postgres
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DATABASE_URL=postgresql+asyncpg://postgres:REPLACE_WITH_STRONG_PASSWORD@db:5432/payroll

# ── JWT ────────────────────────────────────────────────────────────────────────
# ОБЯЗАТЕЛЬНО в каждом окружении — без него backend не запустится.
# Сгенерировать: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET

# ── CORS ────────────────────────────────────────────────────────────────────────
# Домены, которым разрешён браузерный кросс-оригин доступ (через запятую).
# Мобильному приложению не нужно (нативный клиент не шлёт Origin). Заполнять,
# только если появится веб-клиент/админка. Пусто = браузерный доступ запрещён.
ALLOWED_ORIGINS=

# ── Telegram Bot (LEGACY — больше не используется) ───────────────────────────────
# Бот выведен из эксплуатации, продукт — мобильное приложение. Переменная не нужна.
# BOT_TOKEN=

# ── Режим работы ──────────────────────────────────────────────────────────────
DEV_MODE=0
# DEV_KEY нужен только для /dev/ эндпоинтов — в prod не нужен

# ── Версия приложения ─────────────────────────────────────────────────────────
# Увеличивай APP_BUILD каждый раз когда выкладываешь новую IPA/APK
APP_VERSION=1.0.0
APP_BUILD=1

# ── URL сервера ────────────────────────────────────────────────────────────────
# Должен совпадать с доменом в Caddyfile
BASE_URL=https://yourdomain.com

# ── Организация ────────────────────────────────────────────────────────────────
ORG_NAME=Cosmo Studio
ORG_SLUG=cosmo-studio
DEFAULT_ORG_ID=1
ADMIN_LOGIN=REPLACE_WITH_ADMIN_LOGIN
